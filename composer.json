{
    "name": "uzziahlukeka/telegrammonitor",
    "description": "A Laravel package to monitor logs and run a full Telegram support/ticketing tunnel — user DMs become tickets (with optional one-topic-per-ticket forum mode), agent replies are relayed back, plus an embeddable web chat widget and Eloquent activity logging.",
    "keywords": [
        "uzziahlukeka",
        "laravel",
        "telegrammonitor",
        "telegram monitor",
        "telegram",
        "direct message",
        "logs",
        "monitoring",
        "notifications",
        "critical events",
        "realtime",
        "markdown",
        "threaded discussions",
        "Activity logs",
        "support bot",
        "ticketing",
        "web chat",
        "chat widget",
        "livechat"
    ],
    "homepage": "https://github.com/Uzziahlukeka/telegrammonitor",
    "license": "MIT",
    "authors": [
        {
            "name": "Uzziah Lukeka",
            "email": "uzziahlukeka@gmail.com",
            "homepage": "https://github.com/Uzziahlukeka",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/events": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/http": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/routing": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.6",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^9.0.0||^10.0.0||^11.0.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.1||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Uzziahlukeka\\TelegramMonitor\\": "src/",
            "Uzziahlukeka\\TelegramMonitor\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uzziahlukeka\\TelegramMonitor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uzziahlukeka\\TelegramMonitor\\TelegramlogsServiceProvider"
            ],
            "aliases": {
                "Telegramlogs": "Uzziahlukeka\\TelegramMonitor\\Facades\\Telegramlogs",
                "TelegramMessage": "Uzziahlukeka\\TelegramMonitor\\Facades\\TelegramMessage",
                "TelegramActivity": "Uzziahlukeka\\TelegramMonitor\\Facades\\TelegramActivity",
                "TelegramSupport": "Uzziahlukeka\\TelegramMonitor\\Facades\\TelegramSupport"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
